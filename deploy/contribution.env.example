# Placeholder template only. Do not commit real values or secrets.
# The API refuses to start until an operator chooses a numeric retention period.
# Configure the same number on a client to display the notice; server rejects mismatch.
H2S_CONTRIB_RETENTION_DAYS=__OPERATOR_MUST_CHOOSE_DAYS__
H2S_CONTRIB_DB=__ABSOLUTE_PATH_OUTSIDE_REPOSITORY__\contributions.sqlite3
H2S_CONTRIB_LOG_DIR=__ABSOLUTE_LOG_DIRECTORY_OUTSIDE_REPOSITORY__
H2S_CONTRIB_SERVICE_ACCOUNT=NT SERVICE\hardsub-contribution-api
H2S_CONTRIB_PURGE_ACCOUNT=__DEDICATED_NON_ADMIN_PURGE_ACCOUNT__
# Local client only; set outside the repository on each consenting client.
H2S_CONTRIB_URL=https://__OPERATOR_DOMAIN__
H2S_CONTRIB_TOKEN=__ISSUE_AND_STORE_OUTSIDE_REPOSITORY__
