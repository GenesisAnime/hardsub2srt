{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hardsub2srt.invalid/schemas/contribution-metrics-v1.schema.json",
  "title": "hardsub2srt minimized contribution metrics v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "submission_id", "created_at", "metrics"],
  "properties": {
    "schema_version": {"const": 1},
    "submission_id": {"type": "string", "format": "uuid", "maxLength": 36},
    "created_at": {"type": "string", "format": "date-time", "maxLength": 40},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_seconds", "frames_scanned", "cue_count", "low_conf_count", "device_class", "engine_class"],
      "properties": {
        "duration_seconds": {"type": "number", "minimum": 0, "maximum": 86400},
        "frames_scanned": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "cue_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "low_conf_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "device_class": {"enum": ["cuda", "cpu", "unknown"]},
        "engine_class": {"enum": ["easyocr", "rapidocr", "unknown"]},
        "low_conf_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "speech_seconds": {"type": "number", "minimum": 0, "maximum": 86400},
        "cer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "reference_class"],
          "properties": {
            "value": {"type": "number", "minimum": 0, "maximum": 10},
            "reference_class": {"const": "trusted_local_vtt"}
          }
        }
      }
    }
  }
}
