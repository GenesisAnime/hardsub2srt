{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hardsub2srt/ocr-crop-evaluation-report-v1.schema.json",
  "title": "Local human-verified OCR crop-text aggregate evaluation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_id", "status", "created_at", "software", "dataset", "scope", "engines", "release_gate"],
  "properties": {
    "schema_version": {"const": 1},
    "evaluation_id": {"type": "string", "minLength": 1},
    "status": {"const": "CROP_LEVEL_MEASURED_NOT_VIDEO_ACCURACY"},
    "created_at": {"type": "string", "format": "date-time"},
    "software": {"type": "object", "required": ["evaluator_sha256", "ocr_adapter_sha256"], "properties": {
      "evaluator_sha256": {"$ref": "#/$defs/sha256"},
      "ocr_adapter_sha256": {"$ref": "#/$defs/sha256"}
    }},
    "dataset": {
      "type": "object",
      "required": ["manifest_sha256", "metadata_sha256", "split_manifest_sha256", "parent_provenance", "rows", "split", "rights_verified", "rights_review_status"],
      "properties": {
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "metadata_sha256": {"$ref": "#/$defs/sha256"},
        "split_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "parent_provenance": {"type": "object"},
        "rows": {"type": "integer", "minimum": 1},
        "split": {"const": "test"},
        "rights_verified": {"const": false},
        "rights_review_status": {"const": "human_review_attested_not_legally_verified"}
      }
    },
    "scope": {
      "type": "object",
      "required": ["measurement", "video_accuracy_claimed", "cue_detection", "cue_precision", "cue_recall", "timing_start_abs_error_ms", "timing_end_abs_error_ms", "timing_within_tolerance_rate", "normalization", "empty_recognition_counts_as_uncovered_and_empty_prediction", "metrics_persisted"],
      "properties": {
        "measurement": {"const": "human-verified still-crop source-text recognition only"},
        "video_accuracy_claimed": {"const": false},
        "cue_detection": {"type": "null"},
        "cue_precision": {"type": "null"},
        "cue_recall": {"type": "null"},
        "timing_start_abs_error_ms": {"type": "null"},
        "timing_end_abs_error_ms": {"type": "null"},
        "timing_within_tolerance_rate": {"type": "null"},
        "normalization": {"type": "string"},
        "empty_recognition_counts_as_uncovered_and_empty_prediction": {"const": true},
        "metrics_persisted": {"const": "aggregate only; no per-cue recognized/reference text"}
      }
    },
    "engines": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/engine"}},
    "release_gate": {
      "type": "object",
      "required": ["status", "phase6_blocked", "reason"],
      "properties": {
        "status": {"const": "NOT_EVALUATED_CROP_METRICS_ONLY"},
        "phase6_blocked": {"const": true},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metrics": {
      "type": "object",
      "required": ["rows", "coverage", "cer", "wer", "exact_match_rate", "reference_chars", "reference_words", "character_edits", "word_edits", "nonempty_outputs", "empty_reference_rows"],
      "properties": {
        "rows": {"type": "integer", "minimum": 1},
        "coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "cer": {"type": ["number", "null"], "minimum": 0},
        "wer": {"type": ["number", "null"], "minimum": 0},
        "exact_match_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "reference_chars": {"type": "integer", "minimum": 0},
        "reference_words": {"type": "integer", "minimum": 0},
        "character_edits": {"type": "integer", "minimum": 0},
        "word_edits": {"type": "integer", "minimum": 0},
        "nonempty_outputs": {"type": "integer", "minimum": 0},
        "empty_reference_rows": {"const": 0}
      }
    },
    "engine": {
      "type": "object",
      "required": ["engine_id", "split", "micro", "group_macro", "per_source_episode", "device_backend_config", "config"],
      "properties": {
        "engine_id": {"enum": ["easyocr-single", "easyocr-consensus3", "rapidocr-v6-small"]},
        "split": {"const": "test"},
        "micro": {"$ref": "#/$defs/metrics"},
        "group_macro": {"type": "object"},
        "per_source_episode": {"type": "array", "items": {"type": "object"}},
        "device_backend_config": {"type": "object"},
        "config": {"type": "object"}
      }
    }
  }
}
