{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hardsub2srt/ocr-experiment-metadata-v1.schema.json",
  "title": "Local OCR experiment dataset metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cue_id", "source_id", "episode_id", "license"],
        "properties": {
          "cue_id": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "episode_id": {"type": "string", "minLength": 1},
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "identifier", "evidence_ref"],
            "properties": {
              "status": {"enum": ["public_domain", "permissive_license", "permission_granted", "user_owned"]},
              "identifier": {"type": "string", "minLength": 1},
              "evidence_ref": {"type": "string", "minLength": 1, "description": "Local relative document identifier; never an absolute path."}
            }
          }
        }
      }
    }
  }
}
