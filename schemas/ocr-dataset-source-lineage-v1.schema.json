{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hardsub2srt/ocr-dataset-source-lineage-v1.schema.json",
  "title": "Local composite Phase 2 dataset source lineage v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "members"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "phase2-multi-pack-verified-export"},
    "members": {
      "type": "array", "minItems": 3, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_pack_path", "source_export_path", "source_export_manifest_sha256", "review_manifest_sha256", "review_srt_sha256", "review_events_sha256", "cue_ids"],
        "properties": {
          "source_pack_path": {"type": "string", "minLength": 1},
          "source_export_path": {"type": "string", "minLength": 1},
          "source_export_manifest_sha256": {"$ref": "#/$defs/sha256"},
          "review_manifest_sha256": {"$ref": "#/$defs/sha256"},
          "review_srt_sha256": {"$ref": "#/$defs/sha256"},
          "review_events_sha256": {"$ref": "#/$defs/sha256"},
          "cue_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
