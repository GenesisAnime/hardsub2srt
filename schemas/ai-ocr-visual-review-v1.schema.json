{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hardsub2srt.invalid/schemas/ai-ocr-visual-review-v1.schema.json",
  "title": "Manual AI OCR visual review response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "cues"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "cues": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["cue_id", "start_ms", "end_ms", "status", "observed_text", "proposed_text", "reason"],
        "properties": {
          "cue_id": {"type": "string", "pattern": "^[a-f0-9]{32}-cue-[0-9]{5,}$"},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 1},
          "status": {"enum": ["confirmed", "correction_proposed", "uncertain"]},
          "observed_text": {"type": "string", "maxLength": 20000},
          "proposed_text": {"type": ["string", "null"], "maxLength": 20000},
          "reason": {"type": "string", "minLength": 1, "maxLength": 4000}
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "confirmed"}}, "required": ["status"]},
           "then": {"properties": {"proposed_text": {"type": "null"}}}},
          {"if": {"properties": {"status": {"const": "correction_proposed"}}, "required": ["status"]},
           "then": {"properties": {"proposed_text": {"type": "string", "minLength": 1}}}},
          {"if": {"properties": {"status": {"const": "uncertain"}}, "required": ["status"]},
           "then": {"properties": {"proposed_text": {"type": "null"}}}}
        ]
      }
    }
  }
}
