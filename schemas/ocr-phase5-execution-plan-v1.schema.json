{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hardsub2srt/ocr-phase5-execution-plan-v1.schema.json",
  "title": "Frozen local Phase 5 OCR execution plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "dataset", "metadata", "split", "experiment", "references", "media", "profiles", "rights_receipt", "output_parent"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "dataset": {"type": "string", "minLength": 1},
    "metadata": {"type": "string", "minLength": 1},
    "split": {"type": "string", "minLength": 1},
    "experiment": {"type": "string", "minLength": 1},
    "references": {"type": "string", "minLength": 1},
    "rights_receipt": {"type": "string", "minLength": 1},
    "output_parent": {"type": "string", "minLength": 1},
    "media": {"type": "array", "minItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "episode_id", "path", "sha256"], "properties": {"source_id": {"type": "string", "minLength": 1}, "episode_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}},
    "profiles": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["engine_id", "profile_path", "profile_sha256"], "properties": {"engine_id": {"type": "string", "minLength": 1}, "profile_path": {"type": "string", "minLength": 1}, "profile_sha256": {"$ref": "#/$defs/sha256"}}}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
